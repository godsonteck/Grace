generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Branch {
  id           String        @id @default(cuid())
  name         String
  address      String
  phone        String
  email        String
  appointments Appointment[]
  equipment    Equipment[]
  staff        Staff[]
}

model Patient {
  id           String             @id @default(cuid())
  name         String
  email        String             @unique
  phone        String
  dob          DateTime
  gender       String
  bloodGroup   String?
  appointments Appointment[]
  reports      DiagnosticReport[]
}

model Appointment {
  id              String            @id @default(cuid())
  patientId       String
  branchId        String
  scanId          String
  scanName        String
  date            DateTime
  time            String
  status          String            @default("pending")
  priority        String            @default("normal")
  referringDoctor String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  branch          Branch            @relation(fields: [branchId], references: [id])
  patient         Patient           @relation(fields: [patientId], references: [id])
  report          DiagnosticReport?
}

model DiagnosticReport {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  patientId     String
  resultId      String      @unique @default(cuid())
  content       String
  imageUrl      String?
  statFlag      Boolean     @default(false)
  type          String      @default("RADIOLOGY")
  labValues     String?
  createdAt     DateTime    @default(now())
  patient       Patient     @relation(fields: [patientId], references: [id])
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
}

model ReferralDoctor {
  id        String   @id @default(cuid())
  name      String
  facility  String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
}

model Staff {
  id       String @id @default(cuid())
  name     String
  role     String
  branchId String
  phone    String
  email    String
  status   String @default("active")
  branch   Branch @relation(fields: [branchId], references: [id])
}

model Equipment {
  id              String   @id @default(cuid())
  name            String
  type            String
  branchId        String
  lastMaintenance DateTime
  status          String   @default("operational")
  branch          Branch   @relation(fields: [branchId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  user      String
  action    String
  module    String
  timestamp DateTime @default(now())
}
